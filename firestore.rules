rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-Deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email in ['aditiya.ahmad@umc.ac.id', 'aditiya.fadila@umc.ac.id'] ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidRole(role) {
      return role in [
        'ACT-01', 'ACT-02', 'ACT-03', 'ACT-04', 'ACT-05',
        'ACT-06', 'ACT-07', 'ACT-08', 'ACT-09', 'ACT-10'
      ];
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid', 'email', 'nama', 'role', 'hasPassword', 'statusAkun', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'email', 'nama', 'role', 'civitasType', 'hasPassword', 'statusAkun', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == userId
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.nama is string && data.nama.size() >= 1 && data.nama.size() <= 160
        && isValidRole(data.role)
        && (!('civitasType' in data) || (data.civitasType in ['Dosen', 'Karyawan', 'Mahasiswa']))
        && data.hasPassword is bool
        && data.statusAkun in ['Aktif', 'Nonaktif']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminRecord(data, adminId) {
      return data.keys().hasAll(['uid', 'email', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'createdAt'])
        && isValidId(data.uid)
        && data.uid == adminId
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();

      allow create: if isValidId(userId)
        && isSignedIn()
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          isAdmin() || (
            userId == request.auth.uid
            && incoming().email == request.auth.token.email
            && incoming().role == 'ACT-10'
            && incoming().statusAkun == 'Aktif'
          )
        );

      allow update: if isValidId(userId)
        && isSignedIn()
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() || (
            isOwner(userId)
            && incoming().role == existing().role
            && incoming().statusAkun == existing().statusAkun
            && incoming().diff(existing()).affectedKeys().hasOnly(['hasPassword', 'nama', 'updatedAt'])
            && incoming().hasPassword == true
          )
        );

      allow delete: if isValidId(userId) && isAdmin();
    }

    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(adminId) && isAdmin()
        && isValidAdminRecord(incoming(), adminId)
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(adminId) && isAdmin();
    }
  }
}
